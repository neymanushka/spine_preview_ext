{
  "compilerOptions": {
    "module": "node20",
    "target": "es2023",
    "lib": ["es2023"],
    "types": ["node"],
    "outDir": "out",
    "sourceMap": true,
    "strict": true,
    "rootDir": "src",
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "exclude": ["node_modules", ".vscode-test", "src/webview"]
}
