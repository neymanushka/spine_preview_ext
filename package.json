{
  "name": "spine-animation-preview",
  "description": "spine animation preview for vscode",
  "version": "3.4.1",
  "publisher": "neymanushka",
  "private": true,
  "scripts": {
    "pack": "vsce package --allow-missing-repository --no-dependencies",
    "vscode:prepublish": "node ./node_modules/typescript/bin/tsc -p ./ && node esbuild.webview.mjs",
    "compile": "tsc -p ./ && node esbuild.webview.mjs",
    "compile:ext": "tsc -p ./",
    "compile:webview": "node esbuild.webview.mjs",
    "type-check": "tsc --noEmit -p ./ && tsc -p src/webview",
    "lint": "eslint . --fix",
    "watch": "tsc -w -p ./",
    "watch:webview": "node esbuild.webview.mjs --watch"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@esotericsoftware/spine-pixi-v8": "~4.2.120",
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.94.0",
    "@types/vscode-webview": "^1.57.5",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "pixi.js": "^8.22.0",
    "preact": "^10.29.8",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/neymanushka/spine_preview_ext"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "spinePreview.copyAnimationName",
        "title": "Copy Animation Name"
      }
    ],
    "menus": {
      "webview/context": [
        {
          "command": "spinePreview.copyAnimationName",
          "when": "webviewId == 'spinePreview.preview' && webviewSection == 'animationItem'"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "spinePreview.preview",
        "displayName": "Spine preview",
        "selector": [
          {
            "filenamePattern": "*.atlas"
          }
        ]
      }
    ]
  },
  "engines": {
    "vscode": "^1.94.0",
    "node": ">=22",
    "pnpm": ">=7"
  },
  "packageManager": "pnpm@7.32.2",
  "license": "MIT"
}
